# Everything the scripts write next to themselves: downloads, logs, disk reports, generated helpers,
# and installers you supply.
assets/

# Secrets never belong here. The scripts keep them in ~/.config/dev-init/secrets.env inside WSL, outside
# any repo; these lines catch a copy dropped in by mistake.
secrets.env
*.env
.env.*
*.pem
*.key
*.pfx
id_ed25519*

# Run output
*.log
*.tsv
release/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
